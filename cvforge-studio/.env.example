# ==============================================================================
# CVForge Studio — Environment Variables Configuration (.env.example)
# Apple — White Gallery Style Reference | Production Ready
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Backend & Authentication)
# ------------------------------------------------------------------------------
# Obtén estas credenciales en: https://supabase.com/dashboard/project/[TU-PROYECTO]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://[TU-PROJECT-ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tu_anon_key_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=sb_secret_tu_service_role_key_privada_aqui

# ------------------------------------------------------------------------------
# 2. Lemon Squeezy (Merchant of Record - MoR Global Payments & Subscriptions)
# ------------------------------------------------------------------------------
# Panel de desarrollador Lemon Squeezy: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=tu_api_key_aqui
LEMONSQUEEZY_STORE_ID=tu_store_id_aqui
# Secreto para verificar la firma HMAC-SHA256 del webhook en /api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=tu_secreto_seguro_aqui
# ID de la variante para la suscripción mensual Pro ($9.99/mes)
LEMON_VARIANT_ID_PRO=tu_variant_id_suscripcion
# ID de la variante para el pase de descarga única sin marca de agua ($4.99)
LEMON_VARIANT_ID_ONE_TIME=tu_variant_id_pago_unico

# ------------------------------------------------------------------------------
# 3. Application Base Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
