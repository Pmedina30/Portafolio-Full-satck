# ==============================================================================
# CVForge Studio — Environment Variables Configuration (.env.example)
# Apple — White Gallery Style Reference | Production Ready
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Backend & Authentication)
# ------------------------------------------------------------------------------
# Obtén estas credenciales en: https://supabase.com/dashboard/project/[TU-PROYECTO]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://[TU-PROJECT-ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tu_anon_key_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=sb_secret_tu_service_role_key_privada_aqui

VITE_SUPABASE_URL=https://[TU-PROJECT-ID].supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_tu_anon_key_publica_aqui

# ------------------------------------------------------------------------------
# 2. PayPal Official Integration (Subscriptions & Orders)
# ------------------------------------------------------------------------------
# Panel de desarrolladores de PayPal: https://developer.paypal.com/dashboard/applications
NEXT_PUBLIC_PAYPAL_CLIENT_ID=tu_paypal_client_id_publico
VITE_PAYPAL_CLIENT_ID=tu_paypal_client_id_publico
PAYPAL_CLIENT_ID=tu_paypal_client_id_publico
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_privado
PAYPAL_MODE=sandbox # 'sandbox' para pruebas, 'live' para producción
# ID del Plan de Suscripción Pro Creado en PayPal Dashboard ($9.99/mes)
PAYPAL_PLAN_ID_PRO=P-tu_plan_id_recurrente
NEXT_PUBLIC_PAYPAL_PLAN_ID_PRO=P-tu_plan_id_recurrente
VITE_PAYPAL_PLAN_ID_PRO=P-tu_plan_id_recurrente
# ID del Webhook registrado en PayPal Developer Dashboard
PAYPAL_WEBHOOK_ID=tu_paypal_webhook_id

# ------------------------------------------------------------------------------
# 3. Application Base Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
