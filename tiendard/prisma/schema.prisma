// ==============================================================================
// TIENDARD — PRISMA SCHEMA (v2 · PRODUCTION)
// Target: Vercel (Serverless / Edge) + Supabase PostgreSQL
//
// Connection strategy (Supabase Supavisor / PgBouncer):
//   DATABASE_URL → port 6543, transaction pooler, `?pgbouncer=true`  (runtime)
//   DIRECT_URL   → port 5432, direct session connection              (migrations)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

/// Stable machine keys for RBAC. Human-facing metadata lives in the `Role` model.
enum RoleKey {
  SUPER_ADMIN
  ADMIN_LOGISTICS
  ADMIN_COMMERCIAL
  CUSTOMER
}

enum ShippingMethod {
  MARITIMO_STANDARD // 10–15 días laborables · tarifa económica por volumen
  AEREO_EXPRESS     // 3–5 días laborables   · tarifa estándar por libra
  PRIORITY_COURIER  // 24–48 horas laborables · VIP puerta a puerta
}

enum CourierProvider {
  TIENDARD_DIRECT
  EPS
  BM_CARGO
  AEROPAQ
  DOMEX
  POBOX
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING
  IN_TRANSIT
  ON_HOLD_CUSTOMS
  DELIVERED
  CANCELLED
}

enum TrackingStage {
  ORDER_PLACED           // 1. Pedido confirmado
  US_WAREHOUSE_RECEIVED  // 2. Recibido y pesado en Miami, FL
  AIR_MARITIME_TRANSIT   // 3. Vuelo / buque hacia RD
  CUSTOMS_CLEARANCE_DR   // 4. Despacho DGA (AILA / Caucedo)
  LOCAL_COURIER_DISPATCH // 5. En ruta con courier local
  DELIVERED              // 6. Entregado
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
}

enum Currency {
  USD
  DOP
}

// ------------------------------------------------------------------------------
// IDENTITY & ACCESS
// ------------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  key         RoleKey  @unique
  name        String
  description String?
  /// Fine-grained capabilities, e.g. ["orders:read", "tracking:write"]
  permissions String[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  /// scrypt hash: `scrypt$<saltHex>$<hashHex>`
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  isActive     Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Personal Miami forwarding suite, e.g. "TRD-MIA-10482"
  miamiSuiteCode String? @unique

  addresses Address[]
  orders    Order[]

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([roleId])
}

model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label         String  @default("Casa") // Casa, Oficina, Locker…
  recipientName String
  phone         String // 809 / 829 / 849
  province      String // Distrito Nacional, Santo Domingo, Santiago, La Altagracia…
  municipality  String? // Santo Domingo Este, Punta Cana…
  sector        String // Piantini, Naco, Los Jardines…
  street        String
  reference     String? // "Frente al Parque…"
  postalCode    String?
  country       String  @default("DO")

  courierProvider CourierProvider?
  courierLockerId String? // e.g. "EPS-SDQ-44821"

  isDefault Boolean @default(false)
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([province])
}

// ------------------------------------------------------------------------------
// CATALOG
// ------------------------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  /// Lucide icon name in PascalCase, e.g. "Laptop", "Headphones", "Gamepad2"
  icon        String
  sortOrder   Int       @default(0)
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String @id @default(uuid())
  sku         String @unique
  slug        String @unique
  name        String
  brand       String
  description String

  /// All pricing is USD-denominated; DOP is derived from the order FX snapshot.
  priceUSD          Decimal  @db.Decimal(10, 2)
  compareAtPriceUSD Decimal? @db.Decimal(10, 2)

  /// Billable courier weight (lbs) — drives freight calculation.
  weightLbs  Decimal @db.Decimal(6, 2)
  dimensions String?

  stock  Int    @default(0)
  images String[]
  /// Short MP4 demo clip played on hover in the product card.
  videoUrl String?

  rating      Decimal @default(0) @db.Decimal(2, 1)
  reviewCount Int     @default(0)
  badge       String?
  isFeatured  Boolean @default(false)
  /// Key/value technical spec sheet
  specs       Json?
  hsCode      String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([priceUSD])
}

// ------------------------------------------------------------------------------
// ORDERS & LOGISTICS
// ------------------------------------------------------------------------------

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique // "TRD-2026-1001"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  shippingAddressId String
  shippingAddress   Address @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)

  shippingMethod ShippingMethod @default(AEREO_EXPRESS)
  status         OrderStatus    @default(PENDING_PAYMENT)
  currentStage   TrackingStage  @default(ORDER_PLACED)

  // ---- Financial snapshot (computed & locked server-side at checkout) ----
  currency        Currency @default(USD)
  exchangeRate    Decimal  @db.Decimal(10, 4)
  subtotalUSD     Decimal  @db.Decimal(10, 2)
  shippingCostUSD Decimal  @db.Decimal(10, 2)
  insuranceUSD    Decimal  @db.Decimal(10, 2)
  dutyUSD         Decimal  @default(0) @db.Decimal(10, 2) // Gravamen arancelario
  itbisUSD        Decimal  @default(0) @db.Decimal(10, 2) // ITBIS 18 %
  totalUSD        Decimal  @db.Decimal(10, 2)
  totalDOP        Decimal  @db.Decimal(12, 2)
  totalWeightLbs  Decimal  @db.Decimal(7, 2)
  isDgaExempt     Boolean  @default(true)

  // ---- Integrity / payments ----
  idempotencyKey  String?       @unique
  paymentIntentId String?       @unique
  paymentStatus   PaymentStatus @default(PENDING)

  airWaybill        String? @unique // AWB / BL number
  estimatedDelivery DateTime?

  items          OrderItem[]
  trackingEvents TrackingEvent[]

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([currentStage])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Snapshots — protect historical orders from future catalog edits.
  productName   String
  quantity      Int
  unitPriceUSD  Decimal @db.Decimal(10, 2)
  lineTotalUSD  Decimal @db.Decimal(10, 2)
  unitWeightLbs Decimal @db.Decimal(6, 2)

  @@index([orderId])
  @@index([productId])
}

model TrackingEvent {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stage       TrackingStage
  title       String
  description String
  location    String // "Doral, Miami FL", "AILA · Santo Domingo", "Puerto Caucedo"
  facility    String? // "MIA-DRL-01", "SDQ-AILA", "DO-CAUCEDO"
  createdById String? // Admin user who logged the scan
  occurredAt  DateTime @default(now())

  @@index([orderId, occurredAt])
  @@index([stage])
}
