# ==============================================================================
# TIENDARD - ENVIRONMENT CONFIGURATION (.env.example)
# Target Deployment: Vercel Serverless Functions + Supabase Managed PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION POOLING (SUPABASE + SUPAVISOR / PGBOUNCER)
# ------------------------------------------------------------------------------
# DATABASE_URL: Uses port 6543 (transaction mode pooler) for serverless compute on Vercel
# pgbouncer=true prevents prepared statement collisions in pooled connections
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"

# DIRECT_URL: Uses port 5432 (direct PostgreSQL connection) for Prisma migrations & DDL
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE (AUTH & STORAGE BUCKETS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="tiendard-assets"

# ------------------------------------------------------------------------------
# 3. APPLICATION & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="7f8a9b2c3d4e5f60718293a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (STRIPE CROSS-BORDER)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51Px...mock"
STRIPE_SECRET_KEY="sk_test_51Px...mock"
# Crucial: Raw cryptographic signature verification for webhook idempotency
STRIPE_WEBHOOK_SECRET="whsec_0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d"

# ------------------------------------------------------------------------------
# 5. DOMINICAN REPUBLIC LOGISTICS & MONETARY POLICIES
# ------------------------------------------------------------------------------
# Default snapshot exchange rate USD to Dominican Peso (DOP)
DEFAULT_USD_TO_DOP_RATE="59.50"

# DGA Exemption Limit (Dominican Customs Decree 402-05: Category B exempt if CIF < $200 USD)
DGA_EXEMPTION_THRESHOLD_USD="200.00"

# Shipping rates per pound (USD)
SHIPPING_RATE_MARITIMO_PER_LB="1.75"
SHIPPING_RATE_AEREO_PER_LB="3.50"
SHIPPING_RATE_PRIORITY_PER_LB="6.00"

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING (UPSTASH REDIS)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://us1-clean-slug.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AcK...mock"
