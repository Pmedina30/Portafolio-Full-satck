# Configuración de Firebase para ColmadoPro
# Reemplaza con los valores de tu consola Firebase (https://console.firebase.google.com/)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Si dejas las variables vacías, ColmadoPro opera en Modo Demostración Interactivo Local
# con persistencia en LocalStorage y datos reales precargados.

